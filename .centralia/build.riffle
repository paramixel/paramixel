# Build configuration for Paramixel, run by Centralia. It replaces the GitHub
# Actions build and manual-build workflows this repository used before the move
# to Centralia; the documentation job from CI is not mirrored.
#
# Java is preinstalled in the build VM under /opt/java/<N>; 17, 21 and 25 are the
# versions CI covered. "requires" lists files that must exist inside the VM
# before the first command runs, and "paths" puts their bin directory in front
# of PATH. Centralia does not install or discover tools.
#
# Validate with:
#   centralia validate .centralia/build.riffle

jobs : {
    build-java-17 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        requires : [
            /opt/java/17/bin/java
        ]
        paths : [
            /opt/java/17/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/17
            MAVEN_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./mvnw spotless:check
            ./mvnw -B clean install
        ]
    }
    build-java-21 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        requires : [
            /opt/java/21/bin/java
        ]
        paths : [
            /opt/java/21/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/21
            MAVEN_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./mvnw spotless:check
            ./mvnw -B clean install
        ]
    }
    build-java-25 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        requires : [
            /opt/java/25/bin/java
        ]
        paths : [
            /opt/java/25/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/25
            MAVEN_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./mvnw spotless:check
            ./mvnw -B clean install -Dspotbugs.skip=true -Dpmd.skip=true
        ]
    }
    gradle-java-17 : {
        triggers : [
            push
            pull-request
        ]
        labels : [
            linux
        ]
        timeout : 1h
        requires : [
            /opt/java/17/bin/java
        ]
        paths : [
            /opt/java/17/bin
        ]
        environment : {
            JAVA_HOME : /opt/java/17
            GRADLE_OPTS : -Xmx2g -XX:+UseG1GC
        }
        commands : [
            ./gradlew check --no-daemon
        ]
    }
}
